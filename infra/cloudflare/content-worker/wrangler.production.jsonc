{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__CONTENT_WORKER_NAME__",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["__CONTENT_ENGINE_CRON__"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "__ALLOWED_ORIGINS__",
    "GOOGLE_CLIENT_ID": "__GOOGLE_CLIENT_ID__"
  },
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "__CONTENT_DATABASE_NAME__",
      "database_id": "__CONTENT_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ]
}
