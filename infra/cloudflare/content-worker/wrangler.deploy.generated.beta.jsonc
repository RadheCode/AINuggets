{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beta-ai-nuggets-content",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 1,13 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://beta-ai-nuggets.pages.dev,http://localhost:8080,http://127.0.0.1:8080",
    "GOOGLE_CLIENT_ID": "119476209987-a7plo7e675cl200cjnk78msq7ol06umr.apps.googleusercontent.com",
    "DEPLOYMENT_ENVIRONMENT": "beta"
  },
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "beta-ai-nuggets-content",
      "database_id": "ba4fcc26-44d8-4688-adbd-69a2f5ce25af",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
