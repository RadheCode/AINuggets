# Copy this file to providers.local.env and fill in your provider values.
# The local file is ignored by Git and must never be committed.
#
# Optional. Leave empty to use the built-in collector, which fetches the latest
# three posts from each configured RSS/Atom feed in product/config.js.
# Set this only to replace the built-in collector with your own HTTPS JSON API.
CONTENT_SOURCE_URL=

# Optional. Leave empty when the content source does not require authentication.
CONTENT_SOURCE_API_KEY=

# Summary provider selection is driven entirely by the fallbackOrder in
# product/config.js (default: openrouter, then openai, then workers-ai).
# The factory tries each kind in that order, including only the kinds whose
# provider-specific variables below are complete, and uses the first that
# produces a valid edition. Configure whichever providers you have credentials
# for below; the chain activates them automatically.

# --- openrouter ----------------------------------------------------------------
# API key and model for OpenRouter.ai (priority provider in fallback chain).
# OpenRouter exposes an OpenAI-compatible API and can itself fall back across
# many packaged models (OpenAI, Anthropic, Meta, and more).
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=openrouter/free

# --- openai (an OpenAI-compatible /chat/completions API) ----------------------
# All three (base URL, API key, model) are required to enable this kind.
# OPENAI_BASE_URL=https://model-provider.example/v1
# OPENAI_API_KEY=replace-with-openai-api-key
# OPENAI_MODEL=replace-with-model-name

# --- gemini (Google Gemini OpenAI-compatible endpoint) ------------------------
# Both (API key, model) are required to enable this kind. Gemini exposes an
# OpenAI-compatible API at the default base URL from product/config.js.
# GEMINI_API_KEY=replace-with-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# --- workers-ai ----------------------------------------------------------------
# The Cloudflare Workers AI binding (env.AI) is provided by the Worker runtime,
# so no URL or API key is required here. Enable this kind by providing the model
# name; the binding must be declared in the Worker manifest
# (infra/cloudflare/content-worker/wrangler*.jsonc).
# Recommended free model: @cf/meta/llama-3.3-70b-instruct-fp8-fast
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
