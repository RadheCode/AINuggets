# Copy this file to providers.local.env and fill in your provider values.
# The local file is ignored by Git and must never be committed.
#
# Optional. Leave empty to use the built-in collector, which fetches the latest
# three posts from each configured RSS/Atom feed in product/config.js.
# Set this only to replace the built-in collector with your own HTTPS JSON API.
CONTENT_SOURCE_URL=

# Optional. Leave empty when the content source does not require authentication.
CONTENT_SOURCE_API_KEY=

# SUMMARY_PROVIDER_KIND selects which summary provider is built by the content
# generation factory. Supported values:
#   openai      - any OpenAI-compatible /chat/completions API (default)
#   workers-ai  - the Cloudflare Workers AI binding (env.AI), free daily allowance
# Set the matching SUMMARY_PROVIDER_* variables below for the selected kind only.
SUMMARY_PROVIDER_KIND=openai

# --- openai (default) ----------------------------------------------------------
# SUMMARY_PROVIDER_URL is an OpenAI-compatible API base URL, excluding
# /chat/completions.
SUMMARY_PROVIDER_URL=https://model-provider.example/v1
SUMMARY_PROVIDER_API_KEY=replace-with-summary-provider-api-key
SUMMARY_PROVIDER_MODEL=replace-with-model-name

# --- workers-ai ----------------------------------------------------------------
# Set SUMMARY_PROVIDER_KIND=workers-ai to use the Cloudflare Workers AI binding.
# The binding (env.AI) is provided by the Worker runtime, so no URL or API key
# is required here. Only the model name is needed. The binding must be declared
# in the Worker manifest (infra/cloudflare/content-worker/wrangler*.jsonc).
# Recommended free model: @cf/meta/llama-3.3-70b-instruct-fp8-fast
# SUMMARY_PROVIDER_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
